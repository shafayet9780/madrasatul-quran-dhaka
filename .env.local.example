# Site Configuration
NEXT_PUBLIC_SITE_URL=https://madrasatulquranbd.com
NEXT_PUBLIC_SITE_NAME="Madrasatul Quran"

# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_api_token_here

# Internationalization
NEXT_PUBLIC_DEFAULT_LOCALE=bengali
NEXT_PUBLIC_LOCALES=bengali,english

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=info@madrasatul-quran.edu.bd
NEXT_PUBLIC_CONTACT_PHONE=+880-2-1234567
NEXT_PUBLIC_CONTACT_ADDRESS="House 123, Road 456, Dhanmondi, Dhaka 1205"

# Social Media
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/madrasatul.quran
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/c/madrasatulquran

# Google Maps API (for contact page)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=your_google_maps_embed_url

# Analytics (GTM-first)
# The app loads Google Tag Manager only. Configure GA4, Meta Pixel, Clarity, and Ads inside GTM.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Performance Monitoring
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# SEO and Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code
NEXT_PUBLIC_BING_SITE_VERIFICATION=your_bing_verification_code
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=your_yandex_verification_code

# Email Configuration (for contact forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@madrasatul-quran.edu.bd

# Security
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=https://madrasatul-quran.edu.bd

# Sanity Studio Authentication (Production Only)
STUDIO_AUTH_ENABLED=false
STUDIO_USERNAME=admin
STUDIO_PASSWORD=your_secure_password_here

# Share-only downloads library
# Use at least 32 random bytes. Rotating this invalidates every active link/cookie.
DOWNLOADS_LINK_SIGNING_SECRET=
# Must match the secret configured on the signed Sanity downloads webhook.
SANITY_DOWNLOADS_WEBHOOK_SECRET=replace_with_another_long_random_secret
# Vercel Cron sends this value as the Bearer token to scheduled routes.
CRON_SECRET=replace_with_a_third_long_random_secret
# Unreferenced managed uploads are retained this many days before scheduled deletion.
DOWNLOADS_ORPHAN_GRACE_DAYS=7

# Development
NODE_ENV=production

# From your downloaded JSON file:
GOOGLE_PROJECT_ID=your-project-123456
GOOGLE_PRIVATE_KEY_ID=abcdef123456...
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=your-app@project.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=123456789
GOOGLE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# Your form configuration:
FORM_GOOGLE_SHEETS_ID=1ABC123XYZ789...

# Surveys: Neon Postgres (pooled URL for the app, direct URL for migrations) and the
# "Survey Responses" spreadsheet shared with the service account above.
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SURVEY_SHEET_ID=1DEF456UVW...
# Leave SURVEY_SHEET_ID empty locally unless you are testing the Sheet copy (submissions go to the real sheet).
# Nightly survey backup: a separate *private* Vercel Blob store connected with the prefix PG_BACKUP_BLOB.
PG_BACKUP_BLOB_READ_WRITE_TOKEN=
# Set to 1 only in a local .env.local whose DATABASE_URL is the Neon dev branch: allows
# `pnpm test:db`, `pnpm survey:fixtures` and the database e2e specs (they write data).
SURVEY_DEV_DB=

# File storage
FILE_STORAGE_TYPE=vercel-blob
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"
BLOB_STORE_URL=your-blob-store-url

# Optional Google Search Console ownership verification
GOOGLE_SITE_VERIFICATION=

# Pre-admission 2027 (docs/pre-admission-implementation-plan.md)
# Private Blob store for guardians' photos and birth certificates (never public).
ADMISSIONS_BLOB_READ_WRITE_TOKEN=
# SSLCommerz store credentials (the API store password, not the merchant panel password).
# Sandbox unless SSLCOMMERZ_SANDBOX=false; use the live store only on the production domain.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Emails (Resend from the Vercel Marketplace sets RESEND_API_KEY). The sender must be on the
# school's domain verified in Resend.
RESEND_API_KEY=
ADMISSIONS_EMAIL_FROM="Madrasatul Quran <admissions@madrasatulquranbd.com>"
# Optional: key for "Find my application" access cookies (default: derived from CRON_SECRET).
ADMISSIONS_SECRET=
# Optional: a local Chrome/Chromium for application PDFs in development (auto-detected when
# installed in the usual places); Vercel downloads a slim Chromium build instead.
CHROMIUM_EXECUTABLE_PATH=
# Local preview only (never on Vercel): in-memory database, the converted live form, a stand-in
# payment gateway unless the SSLCommerz variables above are set. `ADMISSIONS_LOCAL=1 pnpm dev`.
ADMISSIONS_LOCAL=
